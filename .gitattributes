# Normalize line endings: store text as LF in the repo.
# CRLF/LF churn previously made pdfcadcore_sync_check.py report false "drift"
# between the LF canonical core and CRLF checkouts. Keep repo content LF.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.cfg  text eol=lf
*.toml text eol=lf

# Binary assets - never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.skp binary
*.whl binary

# Preserve third-party FontTools sources and package metadata byte-for-byte.
# Upstream contains intentional/historical trailing whitespace in a few files.
pdf_vector_importer/lib/fontTools/** whitespace=-blank-at-eol,-blank-at-eof
pdf_vector_importer/lib/fonttools-*.dist-info/** whitespace=-blank-at-eol,-blank-at-eof

# Keep the reviewed PyMuPDF wheel and its repair backup byte-identical to upstream.
pdf_vector_importer/lib/pymupdf/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
pdf_vector_importer/lib/fitz/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
pdf_vector_importer/lib/pymupdf-*.dist-info/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
pdf_vector_importer/_vendored_pymupdf_extra.py -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
